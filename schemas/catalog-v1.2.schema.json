{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundation catalog 1.2 (drawing extension)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "catalogId": {
      "const": "foundation-v2"
    },
    "rulesProfile": {
      "const": "historical-foundation-fixtures"
    },
    "basis": {
      "const": "HISTORICAL_TEST_FIXTURE"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "required": [
    "schemaVersion",
    "catalogId",
    "rulesProfile",
    "basis",
    "cards"
  ],
  "additionalProperties": false,
  "$defs": {
    "selector": {
      "type": "object",
      "properties": {
        "zone": {
          "const": "PLAY"
        },
        "entityKind": {
          "enum": [
            "CHARACTER",
            "MINION"
          ]
        },
        "controller": {
          "enum": [
            "ANY",
            "OPPONENT_OF_EFFECT_CONTROLLER"
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "const": "SELF"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "zone",
        "entityKind",
        "controller"
      ],
      "additionalProperties": false
    },
    "targeting": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "REQUIRED",
            "REQUIRED_IF_AVAILABLE",
            "OPTIONAL"
          ]
        },
        "bindAs": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "legalityPolicy": {
          "enum": [
            "SPELL_SELECTED_TARGET",
            "BATTLECRY_SELECTED_TARGET"
          ]
        }
      },
      "required": [
        "mode",
        "bindAs",
        "selector",
        "legalityPolicy"
      ],
      "additionalProperties": false
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "DEAL_DAMAGE"
            },
            "amount": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "CONSTANT"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            "recipient": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "BOUND_TARGET"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "QUERY"
                    },
                    "selector": {
                      "$ref": "#/$defs/selector"
                    },
                    "capture": {
                      "const": "EFFECT_START"
                    }
                  },
                  "required": [
                    "kind",
                    "selector",
                    "capture"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "missingRecipient": {
              "const": "SKIP"
            },
            "application": {
              "enum": [
                "SINGLE_HIT",
                "SINGLE_DAMAGE_BATCH"
              ]
            },
            "damageClass": {
              "enum": [
                "SPELL",
                "ABILITY"
              ]
            }
          },
          "required": [
            "op",
            "amount",
            "recipient",
            "missingRecipient",
            "application",
            "damageClass"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "TRANSFORM"
            },
            "recipient": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "BOUND_TARGET"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "additionalProperties": false
            },
            "targetDefinition": {
              "type": "object",
              "properties": {
                "cardId": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "cardId",
                "revision"
              ],
              "additionalProperties": false
            },
            "missingRecipient": {
              "const": "SKIP"
            }
          },
          "required": [
            "op",
            "recipient",
            "targetDefinition",
            "missingRecipient"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "DRAW_CARD"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "targetPlayer": {
              "enum": [
                "EFFECT_CONTROLLER",
                "OPPONENT_OF_EFFECT_CONTROLLER"
              ]
            }
          },
          "required": [
            "op",
            "count",
            "targetPlayer"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ability": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "BATTLECRY",
            "SPELL_EFFECT"
          ]
        },
        "targeting": {
          "$ref": "#/$defs/targeting"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      },
      "required": [
        "kind",
        "effects"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "enum": [
            "1.1",
            "1.2"
          ]
        },
        "cardId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "MINION",
            "SPELL"
          ]
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NEUTRAL",
              "MAGE",
              "SHAMAN"
            ]
          }
        },
        "baseStats": {
          "type": "object",
          "properties": {
            "manaCost": {
              "type": "integer",
              "minimum": 0
            },
            "attack": {
              "type": "integer",
              "minimum": 0
            },
            "health": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "manaCost"
          ],
          "additionalProperties": false
        },
        "collectible": {
          "type": "boolean"
        },
        "set": {
          "const": "BASIC"
        },
        "rarity": {
          "const": "FREE"
        },
        "tribes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "BEAST"
            ]
          }
        },
        "spellSchool": {
          "type": "null"
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "TAUNT"
            ]
          }
        },
        "mechanics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "BATTLECRY",
              "TRANSFORM"
            ]
          }
        },
        "text": {
          "type": "object",
          "properties": {
            "enUS": {
              "type": "string"
            }
          },
          "required": [
            "enUS"
          ],
          "additionalProperties": false
        },
        "playConditions": {
          "type": "array",
          "maxItems": 0
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ability"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "required": [
        "schemaVersion",
        "cardId",
        "revision",
        "name",
        "type",
        "classes",
        "baseStats",
        "collectible",
        "set",
        "rarity",
        "tribes",
        "spellSchool",
        "keywords",
        "mechanics",
        "text",
        "playConditions",
        "abilities",
        "sources"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "MINION"
              }
            }
          },
          "then": {
            "properties": {
              "baseStats": {
                "required": [
                  "attack",
                  "health"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "baseStats": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "attack"
                      ]
                    },
                    {
                      "required": [
                        "health"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
